{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Siapkan Projek & Database (Onboarding Siswa)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/dokumentasi/06-aturan-agen/skrip/siapkan-projek.ps1"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "2. Quality Gate PHP (0 Error & 0 Warning)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/dokumentasi/06-aturan-agen/skrip/periksa-konsistensi.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "3. Quality Gate Penuh + Playwright E2E",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/dokumentasi/06-aturan-agen/skrip/periksa-konsistensi.ps1",
        "-DenganE2E"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "4. Jalankan Pipeline CI/CD Lokal (Docker / Native)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/dokumentasi/06-aturan-agen/skrip/jalankan-ci-lokal.ps1"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}

