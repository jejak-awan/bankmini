# ==============================================================================
# Contoh Konfigurasi Variabel Lingkungan (.env.example) - Projek Bank Mini
# ==============================================================================
# Catatan untuk Siswa RPL:
# - Pada XAMPP lokal standar, Anda TIDAK wajib membuat file .env karena aplikasi
#   otomatis menggunakan nilai bawaan (127.0.0.1:3306, user: root, tanpa sandi).
# - Variabel di bawah ini digunakan saat menjalankan aplikasi di dalam Docker
#   atau saat port/kata sandi MySQL di komputer Anda berbeda dari bawaan XAMPP.
# ==============================================================================

BANKMINI_URL_DASAR=http://localhost/www/bankmini/public
BANKMINI_MODE_DEBUG=true

BANKMINI_DB_HOST=127.0.0.1
BANKMINI_DB_PORT=3306
BANKMINI_DB_NAMA=bankmini_db
BANKMINI_DB_PENGGUNA=root
BANKMINI_DB_SANDI=
